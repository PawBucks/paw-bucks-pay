{
  "version": 1,
  "sdk_version": "1.0.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://yxpnkipcoxksmnsvpvwi.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "pawbucks-mcp",
      "version": "0.1.0",
      "title": "PawBucks"
    },
    "tools": [
      {
        "name": "search_merchants",
        "title": "Search PawBucks merchants",
